# ── Server ────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── Database ──────────────────────────────────
# Local:      mongodb://localhost:27017/ai-risk-manager
# Atlas:      mongodb+srv://<user>:<pass>@cluster.mongodb.net/ai-risk-manager
MONGODB_URI=mongodb://127.0.0.1:27017/ai_risk_manager

# ── Redis ─────────────────────────────────────
# Local:    redis://localhost:6379/0
# Managed:  redis://:<password>@<host>:<port>/0
REDIS_URL=redis://localhost:6379/0

# ── Auth ──────────────────────────────────────
# IMPORTANT: Change this to a random 64-character string in production!
JWT_SECRET=b3bbb46fe9b52bb224e1b224c200a6568751eedabd17f1342525db2205b1bc5b
JWT_EXPIRES_IN=60m

# ── Services ──────────────────────────────────
# URL of the Python ML microservice
ML_SERVICE_URL=http://localhost:8001

# URL of the frontend (used for CORS)
FRONTEND_URL=http://localhost:5173

# ── LLM Explainability (optional) ─────────────
# Options: mock | openai | gemini
LLM_PROVIDER=mock
OPENAI_API_KEY=
GOOGLE_API_KEY=
GEMINI_API_KEY=

# ── Risk Thresholds (optional) ────────────────
RISK_THRESHOLD_ALLOW=30
RISK_THRESHOLD_MONITOR=60
RISK_THRESHOLD_STEPUP=80
