# ── Server ────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── Database ──────────────────────────────────
# Local:      mongodb://localhost:27017/ai_risk_manager
# Atlas:      mongodb+srv://<user>:<pass>@cluster.mongodb.net/ai_risk_manager
MONGODB_URI=mongodb://127.0.0.1:27017/ai_risk_manager

# ── Redis ─────────────────────────────────────
# Local:    redis://localhost:6379/0
# Managed:  rediss://:<password>@<host>:<port>
REDIS_URL=redis://localhost:6379/0

# ── Auth ──────────────────────────────────────
# IMPORTANT: Change this to a random 64-character string in production!
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_64_CHAR_STRING
JWT_EXPIRES_IN=60m

# ── Services ──────────────────────────────────
# URL of the Python ML microservice
ML_SERVICE_URL=http://localhost:8001

# URL of the frontend (used for CORS)
FRONTEND_URL=http://localhost:5173

# ── LLM Explainability (optional) ─────────────
# Options: mock | openai | gemini
LLM_PROVIDER=mock
OPENAI_API_KEY=
GOOGLE_API_KEY=
GEMINI_API_KEY=

# ── Risk Thresholds (optional) ────────────────
RISK_THRESHOLD_ALLOW=30
RISK_THRESHOLD_MONITOR=60
RISK_THRESHOLD_STEPUP=80

# ── Simulation ────────────────────────────────
# CRITICAL: Set to false to prevent ANY automatic transaction generation.
# The simulation will ONLY run when manually triggered via POST /api/simulation/start
# or POST /api/simulation/demo.
SIMULATION_ENABLED=false

# How many milliseconds between each generated transaction.
# Overrides the rate-based interval when set > 0.
# Default 5000ms = one transaction every 5 seconds.
SIMULATION_INTERVAL_MS=5000

# Maximum number of transactions to generate before stopping automatically.
# Set to 0 for unlimited (not recommended on Atlas Free Tier).
MAX_SIMULATED_TRANSACTIONS=100

# ── Data Retention ────────────────────────────
# Cleanup runs every 50 generated transactions.
# Only removes simulation-generated records (scenarioLabel tagged / isSimulated=true).
# NEVER removes users or manually-created transactions.
MAX_TRANSACTION_RECORDS=10000
MAX_NETWORK_EVENT_RECORDS=10000
MAX_ALERT_RECORDS=5000
MAX_MODEL_PREDICTION_RECORDS=20000
MAX_RISK_ASSESSMENT_RECORDS=10000
