# ── Server ────────────────────────────────────
# Port the ML service listens on (cloud providers set this via $PORT)
PORT=8001

# ── Security ───────────────────────────────────
# Origin of the Node.js backend allowed to call this ML service.
# For production, set this to your deployed backend URL.
BACKEND_ORIGIN=http://localhost:3000

# ── LLM (optional — used by explainController if ML service calls LLM directly) ──
OPENAI_API_KEY=
GEMINI_API_KEY=
